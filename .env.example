# Application Configuration
APP_NAME="AI Resume Screening Assistant"
DEBUG=False

# Google Gemini API Key
GEMINI_API_KEY=your_api_key_here

# JWT Authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Demo Credentials
DEMO_USERNAME=admin
DEMO_PASSWORD=admin

# Database Configuration (PostgreSQL + pgvector)
# The application degrades gracefully if the database is unavailable.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=screening_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/screening_db

# Tenant Context (Default organization ID for hackathon)
DEFAULT_ORG_ID=a0000000-0000-0000-0000-000000000001
