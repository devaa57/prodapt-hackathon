# ==============================================================================
# Database Configuration (PostgreSQL + pgvector)
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=screening_db
DB_USER=postgres
DB_PASSWORD=postgres

# Full PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/screening_db

# Dedicated application role
# DB_APP_USER=app_user
# DB_APP_PASSWORD=app_password

# ==============================================================================
# Vector & Embedding Settings
# ==============================================================================
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ==============================================================================
# Tenant / Organization Context (for development/testing)
# ==============================================================================
DEFAULT_ORG_ID=a0000000-0000-0000-0000-000000000001

# ==============================================================================
# Application & Environment Settings
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
