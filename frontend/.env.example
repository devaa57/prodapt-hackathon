# Backend API Base URL (leave empty to use default http://localhost:8000)
VITE_API_BASE=http://localhost:8000

# Sample / Demo User Credentials
# These match the backend's DEMO_USERNAME / DEMO_PASSWORD env vars
VITE_SAMPLE_USER_NAME=Recruiter Demo
VITE_SAMPLE_USER_USERNAME=demo
VITE_SAMPLE_USER_PASSWORD=password123
